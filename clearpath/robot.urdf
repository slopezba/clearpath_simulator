<?xml version="1.0"?>
<robot name="a200-0000">

  <!-- Base -->
  <link name="base_link"/>
  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_footprint"/>
    <origin xyz="0 0 -0.13228" rpy="0 0 0"/>
  </joint>

  <!-- Wheels -->
  <link name="front_left_wheel"/>
  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_left_wheel"/>
    <origin xyz="0.256 0.2775 0.03282" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="front_right_wheel"/>
  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_right_wheel"/>
    <origin xyz="0.256 -0.2775 0.03282" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="rear_left_wheel"/>
  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_left_wheel"/>
    <origin xyz="-0.256 0.2775 0.03282" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="rear_right_wheel"/>
  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_right_wheel"/>
    <origin xyz="-0.256 -0.2775 0.03282" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Arm UR5e -->
  <link name="arm_0_base_link"/>
  <joint name="arm_0_base_joint" type="fixed">
    <parent link="base_link"/>
    <child link="arm_0_base_link"/>
    <origin xyz="0 0 0.224" rpy="0 0 0"/>
  </joint>

  <link name="arm_0_shoulder_link"/>
  <joint name="arm_0_shoulder_pan_joint" type="revolute">
    <parent link="arm_0_base_link"/>
    <child link="arm_0_shoulder_link"/>
    <origin xyz="0 0 0.1625" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="150.0" lower="-6.283" upper="6.283" velocity="3.14"/>
  </joint>

  <link name="arm_0_upper_arm_link"/>
  <joint name="arm_0_shoulder_lift_joint" type="revolute">
    <parent link="arm_0_shoulder_link"/>
    <child link="arm_0_upper_arm_link"/>
    <origin xyz="0 0 0" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="150.0" lower="-6.283" upper="6.283" velocity="3.14"/>
  </joint>

  <link name="arm_0_forearm_link"/>
  <joint name="arm_0_elbow_joint" type="revolute">
    <parent link="arm_0_upper_arm_link"/>
    <child link="arm_0_forearm_link"/>
    <origin xyz="-0.425 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="150.0" lower="-3.1416" upper="3.1416" velocity="3.14"/>
  </joint>

  <link name="arm_0_wrist_1_link"/>
  <joint name="arm_0_wrist_1_joint" type="revolute">
    <parent link="arm_0_forearm_link"/>
    <child link="arm_0_wrist_1_link"/>
    <origin xyz="-0.3922 0 0.1333" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="28.0" lower="-6.283" upper="6.283" velocity="3.14"/>
  </joint>

  <link name="arm_0_wrist_2_link"/>
  <joint name="arm_0_wrist_2_joint" type="revolute">
    <parent link="arm_0_wrist_1_link"/>
    <child link="arm_0_wrist_2_link"/>
    <origin xyz="0 -0.0997 0" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="28.0" lower="-6.283" upper="6.283" velocity="3.14"/>
  </joint>

  <link name="arm_0_wrist_3_link"/>
  <joint name="arm_0_wrist_3_joint" type="revolute">
    <parent link="arm_0_wrist_2_link"/>
    <child link="arm_0_wrist_3_link"/>
    <origin xyz="0 0.0996 0" rpy="1.5708 3.1416 3.1416"/>
    <axis xyz="0 0 1"/>
    <limit effort="28.0" lower="-6.283" upper="6.283" velocity="3.14"/>
  </joint>

  <!-- Tool and Gripper -->
  <link name="arm_0_tool0"/>
  <joint name="arm_0_tool_joint" type="fixed">
    <parent link="arm_0_wrist_3_link"/>
    <child link="arm_0_tool0"/>
  </joint>

  <link name="arm_0_gripper_robotiq_85_base_link"/>
  <joint name="arm_0_gripper_robotiq_85_base_joint" type="fixed">
    <parent link="arm_0_tool0"/>
    <child link="arm_0_gripper_robotiq_85_base_link"/>
  </joint>

</robot>

